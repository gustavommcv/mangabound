{
  "name": "mangabound",
  "productName": "Mangabound",
  "version": "0.0.0",
  "private": true,
  "description": "A desktop workflow for binding, converting, and delivering manga to e-readers.",
  "author": "Mangabound contributors",
  "main": ".webpack/main",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "pretest:unit": "npm run toolchain:acquire",
    "test:unit": "vitest run --project unit --coverage",
    "test:component": "vitest run --project component",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:stories": "vitest run --project storybook",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:e2e": "wdio run wdio.conf.ts",
    "toolchain:acquire": "node scripts/acquire-toolchain.mjs",
    "toolchain:check": "node scripts/verify-toolchain-lock.mjs",
    "toolchain:update": "node scripts/update-toolchain-lock.mjs --write",
    "audit:production": "npm audit --omit=dev",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run audit:production && npm run toolchain:check && npm run test:unit && npm run test:component && npm run test:stories && npm run build-storybook"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-squirrel-startup": "^1.0.1",
    "lucide-react": "^0.544.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-rpm": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-webpack": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/fuses": "2.1.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/mocha": "10.0.10",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "@wdio/cli": "9.31.9",
    "@wdio/electron-service": "10.3.0",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.31.9",
    "@wdio/mocha-framework": "9.31.9",
    "@wdio/spec-reporter": "9.31.2",
    "@wdio/types": "9.31.2",
    "css-loader": "^7.1.2",
    "electron": "44.3.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "expect-webdriverio": "6.0.10",
    "globals": "^16.4.0",
    "html-webpack-plugin": "^5.6.4",
    "jsdom": "^27.0.0",
    "playwright": "1.63.0",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.2.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "puppeteer-core": "24.43.1",
    "storybook": "10.6.0",
    "style-loader": "^4.0.0",
    "tailwindcss": "4.3.3",
    "ts-loader": "^9.5.4",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "4.1.11",
    "webdriverio": "9.31.9",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  }
}
